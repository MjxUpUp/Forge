        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook file-sentinel --agent copilot",
        "matcher": "Bash",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook tool-track --agent copilot",
        "matcher": "Bash",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook skill-trigger --agent copilot",
        "matcher": "Bash",
        "timeoutSec": 60
