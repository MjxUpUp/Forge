        "type": "command",
        "command": "forge hook assertion-check --agent copilot",
        "matcher": "Write|Edit",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook read-before-edit --agent copilot",
        "matcher": "Write|Edit",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook skill-trigger --agent copilot",
