{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "forge hook auto-compile --agent copilot",
        "matcher": "Write|Edit",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook workflow-test-guard --agent copilot",
        "matcher": "Write|Edit",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook skill-trigger --agent copilot",
        "matcher": "Write|Edit",
        "timeoutSec": 60
      },
      {
        "type": "command",
        "command": "forge hook test-nudge --agent copilot",
