{
  "description": "Forge loop-engineering quality gates: task-tracked source changes, assertion guards, file-sentinel quarantine, and review-gated completion for AI coding agents.",
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event PostCompact --matcher \"\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event PostToolUse --matcher \"Write|Edit\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event PostToolUse --matcher \"Bash\""
          }
        ]
      },
      {
        "matcher": "Read|Skill|Agent|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook tool-track"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook failure-track"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event PreToolUse --matcher \"Write|Edit\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event PreToolUse --matcher \"Bash\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event SessionStart --matcher \"\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event Stop --matcher \"\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "forge hook subagent-track"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "forge hook batch --event UserPromptSubmit --matcher \"\""
          }
        ]
      }
    ]
  },
  "name": "forge"
}
