{
  "apiVersion": "reasonix.io/plugin/v1",
  "description": "Forge loop-engineering quality gates: task-tracked source changes, assertion guards, file-sentinel quarantine, and review-gated completion for AI coding agents.",
  "hooks": {
    "PostToolUse": [
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook auto-compile --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook workflow-test-guard --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook skill-trigger --agent reasonix"
      },
      {
        "match": "bash",
        "command": "forge hook file-sentinel --agent reasonix"
      },
      {
        "match": "bash",
        "command": "forge hook skill-trigger --agent reasonix"
      },
      {
        "match": "read_file",
        "command": "forge hook tool-track --agent reasonix"
      }
    ],
    "PreToolUse": [
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook freeze-guard --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook task-guard --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook assertion-check --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook read-before-edit --agent reasonix"
      },
      {
        "match": "write_file|edit_file|multi_edit|move_file",
        "command": "forge hook skill-trigger --agent reasonix"
      },
      {
        "match": "bash",
        "command": "forge hook bash-guard --agent reasonix"
      },
      {
        "match": "bash",
        "command": "forge hook hazard-guard --agent reasonix"
      },
      {
        "match": "bash",
        "command": "forge hook skill-trigger --agent reasonix"
      }
    ],
    "SessionStart": [
      {
        "command": "forge hook skill-scan"
      },
      {
        "command": "forge hook mcp-scan"
      },
      {
        "command": "forge hook init-suggest"
      },
      {
        "command": "forge hook task-resume"
      },
      {
        "command": "forge hook skill-trigger"
      }
    ],
    "Stop": [
      {
        "command": "forge hook task-verify"
      },
      {
        "command": "forge hook review-stop"
      },
      {
        "command": "forge hook skill-trigger"
      }
    ]
  },
  "name": "forge",
  "version": "1.0.0"
}
